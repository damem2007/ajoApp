# Copy to backend/.env. Exported environment variables take precedence.
# Credentials stay in this ignored file, never in source or client bundles.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/ajo
FRONTEND_URL=http://localhost:9520
CORS_ALLOWED_ORIGINS=http://localhost:9520
AJO_API_HOST=127.0.0.1
AJO_API_PORT=9020

# Explicit sandbox mode: synthetic KYC, signatures and payments.
AJO_DEMO_MODE=true
# Paths below are relative to backend/.env unless absolute.
AJO_DATA_DIR=../.ajo-data
AJO_WORKER_INTERVAL_SECONDS=30

# Optional database override for isolated local testing:
# AJO_PLATFORM_DATABASE_URL=sqlite:///./ajo-platform.db
# Live-mode document encryption requires a mounted base64 key:
# AJO_KEY_FILE=/run/secrets/ajo-encryption-key
# Container-only writable key directory (shared with the worker):
AJO_CONTAINER_DATA_DIR=/data/secrets

# Container listening interface; host-published interfaces remain separate.
AJO_CONTAINER_BIND_HOST=0.0.0.0

# Independent database/provider selection; restart after switching.
AJO_DATABASE_MODE=postgres
AJO_SQLITE_DATABASE_URL=sqlite:////absolute/path/to/ajo-platform.db
AJO_PROVIDER_MODE=simulated

# Provider choice is independent of database choice.
AJO_PAYMENTS_PROVIDER=sandbox
AJO_IDENTITY_PROVIDER=sandbox
AJO_NOTIFICATIONS_PROVIDER=sandbox
# Opt in only after migrations + sync-init on a new fallback file.
AJO_DATABASE_RESILIENCE=false
AJO_FALLBACK_DATABASE_URL=sqlite:////absolute/path/to/.ajo-data/fallback.db
# Containers share this durable volume between API and worker.
AJO_CONTAINER_FALLBACK_DATABASE_URL=sqlite:////data/fallback.db

# Async event delivery. Redis transports event IDs only; PostgreSQL outbox rows remain authoritative.
AJO_REDIS_URL=redis://localhost:6379/0
